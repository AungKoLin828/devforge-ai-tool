{
  "name": "codevia-ai",
  "displayName": "Codevia AI",
  "description": "AI coding assistant connected to the Codevia AI service.",
  "version": "1.0.9",
  "publisher": "CodeviaAI",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:codevia.selectAiProvider",
    "onCommand:codevia.selectProject",
    "onCommand:codevia.signOut",
    "onCommand:codevia.selectBackend",
    "onCommand:codevia.signIn",
    "onCommand:codevia.signInLocal",
    "onCommand:codevia.signInNetlify",
    "onCommand:codevia.openChat",
    "onCommand:codevia.generateProject",
    "onCommand:codevia.reviewCurrentFile",
    "onCommand:codevia.reviewWorkspace",
    "onCommand:codevia.modifyCurrentFile",
    "onCommand:codevia.explainSelection",
    "onCommand:codevia.generateTests",
    "onCommand:codevia.fixCurrentFile",
    "onCommand:codevia.clearFindings"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codevia.signIn",
        "title": "Codevia AI: Sign In (Choose Backend)",
        "category": "Codevia AI"
      },
      {
        "command": "codevia.signInLocal",
        "title": "Codevia AI: Sign In to Local Backend",
        "category": "Codevia AI"
      },
      {
        "command": "codevia.signInNetlify",
        "title": "Codevia AI: Sign In to Hosted Backend",
        "category": "Codevia AI"
      },
      {
        "command": "codevia.selectProject",
        "title": "Codevia AI: Select Project",
        "category": "Codevia AI"
      },
      {
        "command": "codevia.signOut",
        "title": "Codevia AI: Sign Out",
        "category": "Codevia AI"
      },
      {
        "command": "codevia.selectBackend",
        "title": "Codevia AI: Select Backend",
        "category": "Codevia AI"
      },
      {
        "command": "codevia.selectAiProvider",
        "title": "Codevia AI: Select AI Provider & Configure API Key",
        "category": "Codevia AI"
      },
      {
        "command": "codevia.showShortcuts",
        "title": "Codevia AI: Show Shortcuts",
        "category": "Codevia AI"
      },
      {
        "command": "codevia.openChat",
        "title": "Codevia AI: Open Chat",
        "category": "Codevia AI"
      },
      {
        "command": "codevia.generateProject",
        "title": "Codevia AI: Generate Project",
        "category": "Codevia AI"
      },
      {
        "command": "codevia.reviewCurrentFile",
        "title": "Codevia AI: Review Current File",
        "category": "Codevia AI"
      },
      {
        "command": "codevia.reviewWorkspace",
        "title": "Codevia AI: Review Workspace",
        "category": "Codevia AI"
      },
      {
        "command": "codevia.modifyCurrentFile",
        "title": "Codevia AI: Modify Current File",
        "category": "Codevia AI"
      },
      {
        "command": "codevia.explainSelection",
        "title": "Codevia AI: Explain Code / Selection",
        "category": "Codevia AI"
      },
      {
        "command": "codevia.generateTests",
        "title": "Codevia AI: Generate Tests",
        "category": "Codevia AI"
      },
      {
        "command": "codevia.fixCurrentFile",
        "title": "Codevia AI: Fix Errors in Current File",
        "category": "Codevia AI"
      },
      {
        "command": "codevia.clearFindings",
        "title": "Codevia AI: Clear Findings",
        "category": "Codevia AI"
      }
    ],
    "configuration": {
      "title": "Codevia AI Developer Tools",
      "properties": {
        "devforge.backendEnvironment": {
          "type": "string",
          "enum": [
            "local",
            "netlify"
          ],
          "enumDescriptions": [
            "Use the locally running DevForge web app and its local Netlify Functions.",
            "Use the deployed DevForge Netlify site."
          ],
          "default": "netlify",
          "description": "Choose whether Codevia AI uses your local development server or the hosted server. You can also use the Select Backend command."
        },
        "devforge.localBackendUrl": {
          "type": "string",
          "default": "http://localhost:8888",
          "description": "Local DevForge backend base URL. Start the web app with `npm run dev:netlify` so Netlify Functions are available, normally at http://localhost:8888."
        },
        "devforge.netlifyBackendUrl": {
          "type": "string",
          "default": "https://devforge-ai-tool.netlify.app",
          "description": "Base URL of the deployed DevForge Netlify site."
        },
        "devforge.maxWorkspaceFiles": {
          "type": "number",
          "default": 40,
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum number of source files included in one workspace review."
        },
        "devforge.maxFileBytes": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "maximum": 100000,
          "description": "Maximum size of each source file sent for review."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devforgeContainer",
          "title": "Codevia AI",
          "icon": "media/CodeviaAI.png"
        }
      ]
    },
    "views": {
      "devforgeContainer": [
        {
          "id": "devforgeCommandsView",
          "name": "Commands",
          "when": "true"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codevia.openChat",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d"
      },
      {
        "command": "codevia.reviewCurrentFile",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r"
      },
      {
        "command": "codevia.explainSelection",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e"
      },
      {
        "command": "codevia.modifyCurrentFile",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m"
      },
      {
        "command": "codevia.fixCurrentFile",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codevia.openChat",
          "group": "navigation@99"
        },
        {
          "command": "codevia.reviewCurrentFile",
          "when": "editorTextFocus",
          "group": "navigation@100"
        },
        {
          "command": "codevia.modifyCurrentFile",
          "when": "editorTextFocus",
          "group": "navigation@101"
        },
        {
          "command": "codevia.explainSelection",
          "when": "editorTextFocus",
          "group": "navigation@102"
        },
        {
          "command": "codevia.generateTests",
          "when": "editorTextFocus",
          "group": "navigation@103"
        },
        {
          "command": "codevia.fixCurrentFile",
          "when": "editorTextFocus",
          "group": "navigation@104"
        }
      ],
      "explorer/context": [
        {
          "command": "codevia.reviewWorkspace",
          "when": "explorerViewletFocus",
          "group": "navigation@100"
        }
      ],
      "commandPalette": []
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test",
    "package": "npm run compile && npx vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.7.2",
    "@vscode/vsce": "^2.32.0"
  },
  "icon": "media/CodeviaAI.png"
}
