# Local PostgreSQL. Replace YOUR_POSTGRES_PASSWORD with the password set during
# PostgreSQL installation. URL-encode special characters in the password.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devforge?schema=public
# Optional direct/session-pooler URL used for applying Prisma migrations.
# If omitted, migrations use DATABASE_URL.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/codevia_ai?schema=public"
APP_URL=http://localhost:8888
SESSION_SECRET=replace-with-at-least-32-random-characters
CODEVIA_BACKGROUND_SECRET=replace-with-a-long-random-background-function-secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Set this to the deployed site's callback URL in the production environment.
GITHUB_CALLBACK_URL=
# Required for localhost sign-in; use a separate OAuth App with callback
# http://localhost:8888/api/auth/github/callback.
GITHUB_LOCAL_CLIENT_ID=
GITHUB_LOCAL_CLIENT_SECRET=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_MS=45000
# Optional override for the OpenAI-compatible embeddings model used by RAG.
RAG_EMBEDDING_MODEL=

# Local agent
CODEVIA_AGENT_PORT=45821
CODEVIA_AGENT_TOKEN=
DEVFORGE_ALLOWED_ORIGINS=
CODEVIA_WORKSPACE=C:\\DevForge
