# Server only. Set DATABASE_URL to the PostgreSQL connection string from
# Supabase Dashboard > Connect. For local development, use the session pooler
# connection string when a direct database connection is not reachable.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devforge
APP_URL=http://localhost:8888
SESSION_SECRET=replace-with-at-least-32-random-characters
DEVFORGE_BACKGROUND_SECRET=replace-with-a-long-random-background-function-secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Set this to the deployed site's callback URL in the production environment.
GITHUB_CALLBACK_URL=
# Required for localhost sign-in; use a separate OAuth App with callback
# http://localhost:8888/api/auth/github/callback.
GITHUB_LOCAL_CLIENT_ID=
GITHUB_LOCAL_CLIENT_SECRET=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_MS=45000

# Local agent
DEVFORGE_AGENT_PORT=45821
DEVFORGE_AGENT_TOKEN=
DEVFORGE_ALLOWED_ORIGINS=
DEVFORGE_WORKSPACE=C:\\DevForge
